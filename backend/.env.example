# Copy to backend/.env. Generate your own random token, at least 32 characters.
SMARTIVA_API_TOKEN=replace-with-a-long-random-private-token
SMARTIVA_AI_PROVIDER=gemini
SMARTIVA_GEMINI_API_KEY=
SMARTIVA_GEMINI_MODEL=gemini-2.5-flash
# Required for audio transcription, even when Gemini is the extraction provider.
SMARTIVA_GROQ_API_KEY=
SMARTIVA_GROQ_MODEL=llama-3.3-70b-versatile
SMARTIVA_GROQ_WHISPER_MODEL=whisper-large-v3
SMARTIVA_PROVIDER_TIMEOUT_SECONDS=45
SMARTIVA_BRIEFING_TIMEOUT_SECONDS=100
SMARTIVA_MAX_REQUEST_BYTES=12582912
SMARTIVA_MAX_AUDIO_BYTES=10485760
SMARTIVA_MAX_CONCURRENT_BRIEFINGS=4
# PostgreSQL sync. Leave unset only for standalone AI development.
SMARTIVA_DATABASE_URL=postgresql+psycopg://smartiva:change-me@127.0.0.1:5432/smartiva
# Mount a private, persistent volume here; back it up alongside PostgreSQL.
SMARTIVA_AUDIO_STORAGE_PATH=/var/lib/smartiva/audio
